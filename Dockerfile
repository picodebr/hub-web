FROM node:20-alpine

WORKDIR /app

# Adiciona dependência exigida por algumas bibliotecas do Node no Alpine
RUN apk add --no-cache libc6-compat

# 1. Instalação de Dependências
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

# GITHUB ACTIONS VARIABLES
ARG NEXT_PUBLIC_API_ADDRESS
ARG NEXT_PUBLIC_RECAPTCHA_KEY
ARG NEXT_PUBLIC_RECAPTCHA_API_KEY
ARG NEXT_PUBLIC_PHYSICAL_SIMULATOR_URL
ARG NEXT_PUBLIC_COMPILER_API_KEY
ARG NEXT_PUBLIC_COMPILER_API_URL

ENV NEXT_PUBLIC_API_ADDRESS=$NEXT_PUBLIC_API_ADDRESS
ENV NEXT_PUBLIC_RECAPTCHA_KEY=$NEXT_PUBLIC_RECAPTCHA_KEY
ENV NEXT_PUBLIC_RECAPTCHA_API_KEY=$NEXT_PUBLIC_RECAPTCHA_API_KEY
ENV NEXT_PUBLIC_PHYSICAL_SIMULATOR_URL=$NEXT_PUBLIC_PHYSICAL_SIMULATOR_URL
ENV NEXT_PUBLIC_COMPILER_API_KEY=$NEXT_PUBLIC_COMPILER_API_KEY
ENV NEXT_PUBLIC_COMPILER_API_URL=$NEXT_PUBLIC_COMPILER_API_URL

# 2. Build da Aplicação
COPY . .
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN yarn build

# 3. Configurações de Rede para o AWS App Runner
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
EXPOSE 3001

# Inicia a aplicação no modo padrão do Next.js liberando o IP
CMD ["yarn", "start", "-H", "0.0.0.0"]